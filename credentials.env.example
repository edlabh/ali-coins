# ==============================================================================
# AliExpress Coin Collector - Configurações do Ambiente
# ==============================================================================

# Credenciais de autenticação no AliExpress (obrigatórias)
# IMPORTANTE: mantenha os valores SEMPRE entre aspas duplas.
# Caracteres como # (tratado como comentário), espaços e ! exigem aspas,
# caso contrário a senha é truncada silenciosamente. Ex.: ALI_PASSWORD="abc#123!"
ALI_USER=""
ALI_PASSWORD=""

# Suporte Multi-Conta Sequencial (opcional - até 20 contas):
# ALI_USER_2=""
# ALI_PASSWORD_2=""

# Chave secreta de criptografia AES-256-GCM para exportação/importação e repouso (at-rest)
# Deve ter no mínimo 32 caracteres.
# Como gerar a chave de 32 caracteres (32 bytes em Base64):
#   - No Windows usando Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   - No Windows via script de 1 clique: generate_secret.bat (ou .\generate_secret.ps1)
#   - No Linux / macOS / OpenSSL: openssl rand -base64 32
SESSION_SECRET=""

# Chave secreta anterior para rotação suave de chaves criptográficas (mínimo 32 caracteres)
# Quando configurada, a sessão é descriptografada com SESSION_SECRET_OLD e re-criptografada com SESSION_SECRET.
# SESSION_SECRET_OLD=""

# Política de retenção de backups versionados de sessão em scratch/ (padrão: 7 dias)
# SESSION_BACKUP_RETENTION_DAYS=7

# Retenção de artefatos de diagnóstico, traces e logs em scratch/ (padrão: 7 dias)
# DIAGNOSTICS_RETENTION_DAYS=7

# Criptografia local at-rest da sessão em disco (session.json.enc)
# Padrão: true (requer SESSION_SECRET definido)
ENCRYPT_LOCAL_SESSION=true

# Custo computacional scrypt N para derivação de chave v3 (padrão: 131072 = 2^17)
# Piso mínimo de segurança criptográfica: 16384 (2^14).
# Valores abaixo do piso são automaticamente rejeitados com warning no log e clampeados para 131072.
# SCRYPT_N=131072
#
# Hosts com 1 GB de RAM: use SCRYPT_N=32768 (2^15) ou o mínimo seguro 16384 (2^14).
# O scrypt aloca ~128*N*r bytes no pico: com N=131072 isso é ~134 MB instantâneos
# (suficiente para disparar o OOM Killer em VPS pequenas); N=32768 reduz para ~33 MB
# e N=16384 para ~16 MB, mantendo margem de segurança criptográfica aceitável.
# SCRYPT_N=32768

# ==============================================================================
# Notificações via Bot do Telegram (100% opcional - feature OFF por padrão)
# ==============================================================================
# Como configurar:
# 1. Crie seu bot com o @BotFather no Telegram (/newbot) e copie o HTTP API Token.
# 2. Obtenha seu Chat ID enviando uma mensagem para o bot @userinfobot no Telegram.
# 3. Defina TELEGRAM_ENABLED=true e preencha as variáveis abaixo:
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_SILENT=false

# Enviar também a notificação INDIVIDUAL de cada conta, além do relatório consolidado
# (que é SEMPRE enviado). Desligado por padrão (padrão: false) para evitar rajada de
# mensagens quando todas as contas usam o mesmo chat. Ligue com true se quiser receber
# o detalhe de cada conta separadamente (ex.: com TELEGRAM_CHAT_ID_2/3 próprios).
TELEGRAM_PER_ACCOUNT=false

# Timeout por tentativa de envio ao Telegram (ms). Cada tentativa já é re-tentada até 3x
# com backoff em caso de rede/timeout/5xx. Em VPS com DNS/TLS lentos, use 15000.
TELEGRAM_TIMEOUT_MS=15000

# Rótulo customizado do host/máquina para exibição nas mensagens do Telegram (padrão: hostname do sistema via os.hostname())
# NOTIFY_HOST_LABEL="servidor-producao-01"

# Chat IDs específicos para contas secundárias (opcional):
# TELEGRAM_CHAT_ID_2=""
# TELEGRAM_CHAT_ID_3=""
# Obs: com TELEGRAM_PER_ACCOUNT=false, se o chat de uma conta for igual ao TELEGRAM_CHAT_ID
# global, a mensagem individual dessa conta é suprimida (o consolidado já cobre o destino).

# ==============================================================================
# Dead Man's Switch / Monitoramento de Uptime (Heartbeat) (opcional - OFF por padrão)
# ==============================================================================
# Monitora se o cron ou servidor parou de executar (ex: Healthchecks.io, Uptime Kuma)
# Configuração: Period 24h, Grace 1h (alerta se ~25h passarem sem ping do job).
# HEARTBEAT_URL="https://hc-ping.com/seu-uuid-aqui"
# HEARTBEAT_TIMEOUT_MS=5000

# ==============================================================================
# Segurança de destinos externos (webhook/heartbeat) — SSRF
# ==============================================================================
# Notificações para webhooks e heartbeat validam o destino e BLOQUEIAM por padrão
# endereços loopback/privados (127.0.0.1, 10.x, 192.168.x, 169.254.169.254 etc.),
# evitando SSRF. Em testes locais, permita destinos privados explicitamente:
# ALLOW_PRIVATE_WEBHOOKS=true

# ==============================================================================
# Desempenho e Navegador
# ==============================================================================
# Bloquear imagens, mídias pesadas e fontes para acelerar execução e economizar tráfego (padrão: false)
ALLOW_MEDIA=false

# Executar navegador Chromium em modo headless (sem janela gráfica) (padrão: true)
HEADLESS=true

# Nível de logging estruturado (trace | debug | info | warn | error) (padrão: info)
LOG_LEVEL=info
# Valores aceitos: trace, debug, info, warn, error, fatal, silent (padrão: info)

# Desativar sandbox do Chromium caso necessário (ex: Ubuntu 23.10/24.04 LTS com AppArmor restritivo de userns)
# NO_SANDBOX=false

# ==============================================================================
# Controle Anti-Travamento e Execução de Tarefas (opcional)
# ==============================================================================
# Desistência por rodada idêntica sem progresso em statusText/completedRounds (padrão: 3)
# TASK_ROUND_MAX_ATTEMPTS=3

# Tempo limite máximo de execução por tentativa individual de tarefa em ms (padrão: 180000 = 3min)
# TASK_MAX_DURATION_MS=180000

# Teto máximo de permanência/scroll em páginas lentas de tarefas em ms (padrão: 30000 = 30s)
# TASK_SCROLL_MAX_MS=30000

# Reutilizar UM único contexto desktop (mycoin) por conta para as leituras de saldo/streak,
# em vez de criar/fechar um contexto a cada leitura.
# Padrão: false. Em hosts restritos (1 GB) medimos que manter o contexto desktop vivo durante
# o fluxo mobile ELEVA o pico de RAM (contextos concorrentes). Habilite (=true) somente se
# o host tiver folga de memória e você quiser priorizar tempo de execução.
# DESKTOP_REUSE_CONTEXT=false

# Segunda passada: ao final, reabre e reprocessa APENAS as tarefas que falharam/não
# concluíram nenhuma rodada (ou concluíram parcialmente). Desligado por padrão (false).
# TASK_RETRY_UNFINISHED=true
# Quantidade de passadas extras (padrão: 1)
# TASK_RETRY_PASSES=1
# Espera entre passadas em ms para o site consolidar o progresso (padrão: 5000)
# TASK_RETRY_DELAY_MS=5000

# Pausa aleatória (ms) antes de cada tarefa do painel, sorteada entre MIN e MAX (inclui a 1ª tarefa,
# logo após o check-in). Deixa o ritmo menos mecânico. Padrão 0/0 = desligada. Ex.: 15000 e 60000
# somam ~8 min a um run de ~4 min. MAX deve ser >= MIN.
# TASK_PAUSE_MIN_MS=0
# TASK_PAUSE_MAX_MS=0

# Pausa aleatória (ms) entre contas no modo multi-conta (após o check-in+tarefas de uma conta,
# antes de iniciar a próxima). Randomiza o início de cada conta e reduz o padrão mecânico.
# Padrão 0/0 = desligada. Ex.: 60000 e 180000 = 1 a 3 min entre contas. MAX deve ser >= MIN.
# O log e a notificação de cada conta informam o horário previsto da próxima conta.
# ACCOUNT_DELAY_MIN_MS=0
# ACCOUNT_DELAY_MAX_MS=0

# Desligar a verificação das tarefas que exigem o app nativo e nunca concluem via web:
# Prize Land / Fazenda Mágica (regar), minigames (ex: Merge Boss), quizzes e avaliações
# de pedidos. Elas são ignoradas no loop (sem consumir tentativas/ações) e aparecem no
# relatório como "Desativada". Defina como false para voltar a tentá-las. (padrão: true)
SKIP_APP_ONLY_TASKS=true

# ==============================================================================
# Diagnósticos de Falha e Higiene de Sessões (opcional)
# ==============================================================================
# Anexar HTML completo do DOM nos artefatos de falha em scratch/ (padrão: false - grava apenas hash SHA-256)
# PW_DUMP_DOM=false

# Capturar screenshots de falha da página inteira (padrão: false - apenas viewport).
# Em páginas infinitas o full page pode gerar imagens enormes e picos de RAM no caminho de erro.
# PW_SCREENSHOT_FULL_PAGE=false

# Preservar arquivos session_token*.txt após importação via 'node import_session.js --all' (padrão: false - uso único)
# KEEP_SESSION_TOKENS=false

# ==============================================================================
# Hosts com Pouca Memória (ex: VPS de 1 GB) — opcional
# ==============================================================================
# Flags de baixo consumo do Chromium são aplicadas POR PADRÃO:
#   --disable-gpu --disable-software-rasterizer --renderer-process-limit=1
#   --js-flags=--max-old-space-size=128 --disk-cache-size=10485760
# Obs: --no-zygote só é adicionado quando o sandbox está desabilitado (exigência do
# próprio Chromium), ou seja, com NO_SANDBOX=true/root/CI.
# Para DESATIVAR (hosts folgados ou troubleshooting de renderização), defina como false.
# CHROMIUM_LOW_MEMORY=false

# Flags de economia de CPU/rede são aplicadas SEMPRE (independentem do modo acima):
#   --disable-background-networking --disable-component-update --disable-sync
#   --disable-breakpad --mute-audio --no-first-run --metrics-recording-only etc.
# Service workers são bloqueados por padrão (reduz CPU/RAM em background). Se alguma
# página exigir service worker, desative o bloqueio:
# PW_BLOCK_SERVICE_WORKERS=false

# Heap máximo do V8 dentro do Chromium em MB (padrão: 128). Aumente (ex: 256) se páginas
# muito pesadas causarem crash de renderer; reduza para hosts com ainda menos RAM.
# CHROMIUM_JS_HEAP_MB=128

# Trace do Playwright (screenshots+snapshots por contexto). Em hosts apertados, 'off'
# reduz CPU/disco durante a execução; os screenshots manuais de falha continuam sendo gerados.
# Valores: off | on | retain-on-failure | on-first-retry
# Padrão: off quando o modo de baixo consumo está ativo (CHROMIUM_LOW_MEMORY padrão);
# retain-on-failure em hosts folgados (CHROMIUM_LOW_MEMORY=false).
# PW_TRACE=off

# ==============================================================================
# Opções avançadas — detalhes de cada uma no README.md (seção 3 e Segurança)
# ==============================================================================
# Fuso dos RELATÓRIOS (apenas exibição). O "dia" contábil do extrato/streak é sempre
# America/Los_Angeles (fuso da AliExpress).
# REPORT_TIMEZONE=America/Los_Angeles

# Timeouts e ritmo da automação
# SELECTOR_TIMEOUT=8000
# ELEMENT_TIMEOUT=4000
# NAV_TIMEOUT_SHORT=20000
# SCROLL_WAIT_SECONDS=10

# Lock entre execuções (considera obsoleto após este tempo)
# LOCK_STALE_TIMEOUT_MS=1800000

# Cooldown pós-captcha (horas): após um desafio anti-bot no login, novas tentativas ficam
# pausadas por este período (evita insistência que escala o desafio/bloqueio). 0 desliga.
# CAPTCHA_COOLDOWN_HOURS=12

# Backoff exponencial entre contas (base em ms, teto de 30s)
# ACCOUNT_BACKOFF_BASE_MS=2000

# Filtro estrito de localStorage (allowlist) e fallback de detalhe do minigame
# SESSION_STRICT_STORAGE=true
# SURPRISE_DETAIL_FALLBACK=true

# Diagnóstico (artefatos gravados em scratch/ por padrão)
# PW_OUTPUT_DIR=scratch
# PW_SCREENSHOT=only-on-failure
# PW_VIDEO=off

# Heartbeat: a URL já habilita por padrão; use false para desligar por env
# HEARTBEAT_ENABLED=false

# Rótulo do host exibido nas notificações (padrão: hostname da máquina)
# NOTIFY_HOST_LABEL=servidor-producao-vps
