{
  "name": "ali-coins",
  "version": "1.6.2",
  "description": "Automação resiliente de check-in diário e tarefas de moedas do AliExpress com Playwright.",
  "main": "all.js",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "*.js",
    "libs/**/*.js",
    "!libs/extracted/**",
    "*.sh",
    "*.bat",
    "*.ps1",
    "Dockerfile",
    ".dockerignore",
    "credentials.env.example",
    "CHANGELOG.md",
    "RELEASING.md"
  ],
  "scripts": {
    "start": "node all.js",
    "all": "node all.js",
    "collect": "node collect.js",
    "tasks": "node do_tasks.js",
    "test": "node --test --test-concurrency=1 --test-timeout=35000",
    "test:coverage": "node --experimental-test-coverage --test-coverage-lines=80 --test --test-concurrency=1 --test-timeout=35000",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "notify:test": "node -e \"require('./libs/notify').test()\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "aliexpress",
    "playwright",
    "coins",
    "automation"
  ],
  "author": "agiler",
  "license": "ISC",
  "dependencies": {
    "commander": "^15.0.0",
    "dotenv": "^18.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.63.0",
    "undici": "^8.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.8"
  }
}
